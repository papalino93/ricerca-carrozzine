# Basic Auth per /admin (elenco dispositivi + impostazioni azienda)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-questa-password

# Facoltativa ma consigliata: firma il cookie della pagina di accesso.
# Se vuota, la chiave viene derivata da ADMIN_PASSWORD.
AUTH_SESSION_SECRET=

# Recupero credenziali via Resend (piano gratuito sufficiente per questo uso).
# Separa più destinatari con una virgola; non inserire indirizzi reali nel repository.
RESEND_API_KEY=
AUTH_RECOVERY_EMAILS=
AUTH_RECOVERY_FROM="Medical Center <onboarding@resend.dev>"
AUTH_RECOVERY_SECRET=
APP_URL=https://medical-center-scandicci.vercel.app

# Google Sheets: foglio con le tab "Dispositivi" e "Impostazioni"
# (vedi README per come creare l'account di servizio e condividere il foglio)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Nel .env locale può stare su più righe; su Vercel incollala con gli "\n" letterali
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Nessuna variabile per il logo: viene salvato come data URI direttamente
# nella cella LogoURL del foglio (vedi README).

# Facoltative — backup e firma digitale (vedi README): l'app funziona
# normalmente anche senza, restano solo disattivate le relative sezioni.
GOOGLE_SHEETS_BACKUP_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Facoltativa — archiviazione PDF dei Fascicoli Plantari (vedi README): se
# assente, ricade su GOOGLE_DRIVE_FOLDER_ID; se anche quella è assente, i
# PDF restano scaricabili ma non archiviati automaticamente.
GOOGLE_DRIVE_FASCICOLI_FOLDER_ID=
