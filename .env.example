# Basic Auth per /admin (elenco dispositivi + impostazioni azienda)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-questa-password

# Google Sheets: foglio con le tab "Dispositivi" e "Impostazioni"
# (vedi README per come creare l'account di servizio e condividere il foglio)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Nel .env locale può stare su più righe; su Vercel incollala con gli "\n" letterali
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Blob Storage, per l'upload del logo aziendale (vedi README)
BLOB_READ_WRITE_TOKEN=
